# dependencies
node_modules/
.pnpm-store/

# build output
dist/
build/
*.tsbuildinfo
apps/web/dist/
apps/api/dist/

# env & secrets: NEVER commit real values
.env
.env.local
.env.*.local
*.pem
*.key
# file-backed secret store for third-party credentials (FR-004)
.secrets/
# local dry-run / KEEP_LOCAL backup artifacts
.vitae-backup/

# firebase emulator state
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
firebase-export/
emulator-data/
.emulator-data/

# test / coverage
coverage/
playwright-report/
playwright-report-cloud/
test-results/
test-results-cloud/
.playwright/
.stryker-tmp/
packages/*/reports/
packages/*/.stryker-tmp/

# latex build artifacts
*.aux
*.log
*.out
templates/**/*.pdf
*.synctex.gz

# logs & os
*.log
.DS_Store
Thumbs.db

# editor
.vscode/
.idea/
*.swp

.vercel

# Local session transcripts and one-off helpers
2026-*.txt
e2e/2026-*.txt

# Isolated git worktrees for feature branches.
.worktrees/

# Machine-generated local review output.
/reviews/

# Local graph bundles may contain personal records. `docs/` is otherwise
# tracked, so keep private bundles outside the repository.
docs/seeds/

# Local one-off dumps (merged PDFs, ad-hoc export zips), never ship
/*.pdf
/snapshots/


# The per-symbol engineering atlas is rebuilt by `pnpm docs:gen` on demand. Its
# summary is tracked so the reference surface and the drift gates have a
# committed baseline; the full index is ~3 MB of per-symbol detail that would
# churn on every rename and make diffs unreadable.
docs/generated/atlas.json

# The compiled documentation corpus. Private: served by the API out of
# DOCS_CONTENT_DIR, never from the web bundle.
docs/.compiled/
# Kept as a safety net. The corpus must never be written under apps/web/public/
# again: anything there is copied into the bundle and served to anyone.
apps/web/public/docs-content/

# The corpus as published to a deployment host, copied there by
# scripts/deploy-api.sh. A build artifact on the VM, never a tracked file.
deploy/docs-content/
