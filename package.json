{
  "name": "vitae",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Vitae: a self-hosted life and career system with a deterministic LaTeX resume engine.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.23.0 <23",
    "pnpm": ">=9.15.0 <10"
  },
  "scripts": {
    "dev": "pnpm run --parallel --stream -r dev",
    "dev:emulators": "firebase emulators:start --only auth",
    "dev:api": "pnpm --filter @vitae/api dev",
    "dev:web": "pnpm --filter @vitae/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "pnpm -r test",
    "test:core": "pnpm --filter @vitae/core test",
    "test:unit": "pnpm --filter @vitae/core test && pnpm --filter @vitae/testkit test",
    "test:property": "pnpm --filter @vitae/core exec vitest run property metamorphic golden",
    "test:api": "pnpm --filter @vitae/api test",
    "test:web": "pnpm --filter @vitae/web test",
    "openapi": "pnpm --filter @vitae/api openapi",
    "test:contract": "pnpm --filter @vitae/api exec vitest run src/__tests__/contracts",
    "test:a11y": "pnpm --filter @vitae/web exec vitest run a11y",
    "test:e2e": "pnpm --filter @vitae/e2e test",
    "test:visual": "pnpm --filter @vitae/e2e exec playwright test visual-baselines",
    "test:security": "pnpm --filter @vitae/api exec vitest run src/__tests__/security src/middleware/security.test.ts src/middleware/auth.test.ts",
    "test:performance": "node scripts/check-web-budgets.mjs",
    "test:resilience": "pnpm --filter @vitae/api exec vitest run src/__tests__/resilience src/services/buildsvc-client.test.ts",
    "test:mutation": "pnpm --filter @vitae/core test:mutation",
    "test:coverage": "pnpm --filter @vitae/core exec vitest run --coverage && pnpm --filter @vitae/testkit test",
    "test:map": "node scripts/check-test-coverage-map.selftest.mjs && node scripts/check-test-coverage-map.mjs",
    "test:prose": "node scripts/check-test-prose.mjs",
    "test:public": "node scripts/check-public-release.mjs",
    "test:brand": "node scripts/check-brand-bans.mjs",
    "docs:gen": "node scripts/docs/gen-traceability.mjs && node scripts/docs/gen-srs.mjs",
    "docs:check": "node scripts/docs/lib/json-schema.selftest.mjs && node scripts/docs/lib/citations.selftest.mjs && node scripts/check-docs-traceability.selftest.mjs && node scripts/check-docs-traceability.mjs && node scripts/docs/gen-srs.mjs --check",
    "test:all": "pnpm test:map && pnpm test:prose && pnpm test:public && pnpm test:brand && pnpm docs:check && pnpm test:unit && pnpm test:web && pnpm test:a11y && pnpm test:performance",
    "e2e": "pnpm --filter @vitae/e2e test",
    "seed": "pnpm --filter @vitae/api seed",
    "seed:demo": "pnpm --filter @vitae/api seed:demo",
    "backfill:subjects": "pnpm --filter @vitae/api backfill:subjects",
    "export:bundle": "pnpm --filter @vitae/api export:bundle",
    "backup:s3": "./scripts/backup-to-s3.sh",
    "restore:s3": "./scripts/restore-from-s3.sh",
    "assets:favicons": "node scripts/generate-brand-assets.mjs",
    "buildsvc:up": "docker compose up -d buildsvc",
    "buildsvc:down": "docker compose down",
    "audit:graph": "pnpm --filter @vitae/api audit:graph",
    "tidy:import": "pnpm --filter @vitae/api tidy:import",
    "dev:db": "docker compose up -d postgres && pnpm --filter @vitae/api migrate",
    "migrate": "pnpm --filter @vitae/api migrate",
    "load:bundle": "pnpm --filter @vitae/api load:bundle"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-tools": "13.35.1",
    "globals": "^17.7.0",
    "prettier": "^3.4.2",
    "sharp": "^0.35.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1"
  },
  "pnpm": {
    "overrides": {
      "fast-xml-parser@<5.10.1": ">=5.10.1",
      "brace-expansion": ">=2.1.4",
      "minimatch>brace-expansion": "2.1.4",
      "js-yaml@3": "3.15.1",
      "js-yaml@4": "4.3.1",
      "uuid@<11.1.1": ">=11.1.1",
      "nanoid@<3.3.18": ">=3.3.18",
      "tar": ">=7.5.22",
      "undici": ">=8.9.0",
      "fast-uri": ">=3.1.5",
      "postcss": ">=8.5.23",
      "ip-address": ">=10.3.1"
    }
  }
}
