{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vitae.invalid/registry/requirements.schema.json",
  "title": "Vitae requirement register",
  "type": "object",
  "required": ["note", "provenance_vocabulary", "implementation_status_vocabulary", "id_aliases", "numbering_gaps", "requirements"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "note": { "type": "string", "minLength": 1 },
    "provenance_vocabulary": { "type": "object", "additionalProperties": { "type": "string" } },
    "implementation_status_vocabulary": { "type": "object", "additionalProperties": { "type": "string" } },
    "id_aliases": {
      "description": "Unprefixed spellings that appear in existing documents, mapped to the canonical identifier.",
      "type": "object",
      "propertyNames": { "pattern": "^[A-Z][A-Z0-9]{1,4}-[0-9]{3}$" },
      "additionalProperties": { "pattern": "^(FR|NFR)(-[A-Z][A-Z0-9]{1,4})?-[0-9]{3}$" }
    },
    "alias_note": { "type": "string" },
    "families": {
      "description": "Identifier families beyond FR and NFR that the citation reader must opt into by name.",
      "type": "object",
      "propertyNames": { "pattern": "^[A-Z][A-Z0-9]{1,4}$" },
      "additionalProperties": {
        "type": "object",
        "required": ["title", "numbering", "note"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "numbering": { "type": "string", "minLength": 1 },
          "note": { "type": "string", "minLength": 1 }
        }
      }
    },
    "unmodelled_markers": {
      "description": "Identifier-shaped markers found in source that this register deliberately does not model, with the reason.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["marker", "cited_at", "observation"],
        "additionalProperties": false,
        "properties": {
          "marker": { "type": "string", "minLength": 1 },
          "cited_at": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[^/].*:[0-9]+$" } },
          "observation": { "type": "string", "minLength": 1 }
        }
      }
    },
    "numbering_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["range", "observation"],
        "additionalProperties": false,
        "properties": {
          "range": { "type": "string", "minLength": 1 },
          "observation": { "type": "string", "minLength": 1 }
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/requirement" }
    }
  },
  "$defs": {
    "requirement": {
      "type": "object",
      "required": ["id", "capability", "kind", "title", "statement", "implementation_status", "definition_provenance", "review"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^(FR|NFR)(-[A-Z][A-Z0-9]{1,4})?-[0-9]{3}$|^[A-Z][A-Z0-9]{1,4}-[0-9]{1,3}$" },
        "capability": { "type": "string", "pattern": "^CAP-[A-Z-]+$" },
        "kind": { "enum": ["functional", "non-functional", "interface"] },
        "title": { "type": ["string", "null"], "minLength": 1 },
        "statement": { "type": ["string", "null"], "minLength": 1 },
        "implementation_status": { "enum": ["implemented", "partial", "planned", "unknown"] },
        "definition_provenance": { "enum": ["reconstructed", "unrecoverable"] },
        "review": { "enum": ["needs-review", "confirmed"] },
        "reconstruction_note": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "description": "A reconstructed requirement must carry both a title and a statement.",
          "if": { "properties": { "definition_provenance": { "const": "reconstructed" } } },
          "then": { "properties": { "title": { "type": "string" }, "statement": { "type": "string" } } }
        },
        {
          "description": "An unrecoverable requirement records no statement and must explain why.",
          "if": { "properties": { "definition_provenance": { "const": "unrecoverable" } } },
          "then": {
            "required": ["reconstruction_note"],
            "properties": { "title": { "type": "null" }, "statement": { "type": "null" } }
          }
        }
      ]
    }
  }
}
