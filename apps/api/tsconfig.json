{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "composite": false,
    "resolveJsonModule": true,
    "noUncheckedIndexedAccess": false
  },
  "include": ["src/**/*.ts"]
}
