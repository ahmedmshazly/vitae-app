{
  "name": "@vitae/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Vitae REST API: Express + Postgres, /api/v1.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "migrate": "tsx src/scripts/migrate.ts",
    "load:bundle": "tsx src/scripts/load-bundle.ts",
    "typecheck": "tsc --noEmit",
    "openapi": "tsx src/openapi/generate.ts",
    "test": "vitest run",
    "restore": "tsx src/scripts/restore.ts",
    "export:bundle": "tsx src/scripts/export-bundle.ts",
    "seed": "tsx src/scripts/seed.ts",
    "seed:demo": "tsx src/scripts/seed-demo.ts",
    "seed:productivity-perf": "tsx src/scripts/seed-productivity-perf.ts",
    "backfill:subjects": "tsx src/scripts/backfill-subjects.ts",
    "purge": "tsx src/scripts/purge.ts",
    "audit:graph": "tsx src/scripts/audit-graph.ts",
    "tidy:import": "tsx src/scripts/tidy-import.ts",
    "import:gmail": "tsx src/scripts/import-gmail-sqlite.ts"
  },
  "dependencies": {
    "@vitae/config": "workspace:*",
    "@vitae/core": "workspace:*",
    "archiver": "^7.0.1",
    "cloudinary": "^2.5.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase-admin": "^13.0.2",
    "flexsearch": "^0.7.43",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "kysely": "^0.29.4",
    "openapi3-ts": "4.6.1",
    "pg": "^8.22.0",
    "tsx": "^4.19.2",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/pg": "^8.20.1",
    "@types/supertest": "^6.0.2",
    "@vitae/testkit": "workspace:*",
    "@vitest/coverage-v8": "^3.2.7",
    "supertest": "^7.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  }
}
