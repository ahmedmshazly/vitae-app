# ─────────────────────────────────────────────────────────────────────────────
# Vitae environment variables (NAMES ONLY; never commit real values)
# Copy to `.env` and fill in. `.env` is git-ignored.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
# NODE_ENV is deliberately absent. Vite reads this file too, and a NODE_ENV
# found here outranks the `production` that `vite build` sets for itself, so a
# copy of this file turns every local `pnpm build` into a development build:
# a megabyte larger, carrying the development JSX runtime, and embedding your
# absolute source paths in the emitted JavaScript. `packages/config/src/env.ts`
# defaults it to development for the API, and the containers and CI jobs that
# need another value set it themselves.

API_PORT=4000
WEB_PORT=5173
# Browser origins allowed by CORS. localhost and 127.0.0.1 are different origins;
# list every host:port the web app is actually served from.
# WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Public base URL of the API, consumed by the web app at build time.
VITE_API_BASE_URL=http://localhost:4000/api/v1
# Optional canonical source link for the public site. When omitted, the site
# uses a neutral GitHub source-discovery query and publishes no maintainer ID.
# VITE_PUBLIC_REPOSITORY_URL=https://github.com/your-org/vitae

# ── Public Cloud launch gate ─────────────────────────────────────────────────
# The marketing site stays pre-launch and unindexed unless every public legal
# value below is explicitly configured. These are public identifiers, never
# billing keys or provider secrets. The API has a separate, stricter release
# gate for provisioning and billing.
VITE_PUBLIC_CLOUD_ENABLED=false
# VITE_PUBLIC_SITE_URL=https://app.example.com
# VITE_PUBLIC_SUPPORT_EMAIL=support@example.com
# VITE_PUBLIC_LEGAL_ENTITY_NAME=Example, Inc.
# VITE_PUBLIC_LEGAL_TERMS_VERSION=2026-08-23
# Public, checkout-scoped Paddle token. It is safe to expose in the browser;
# never put a Paddle API key in a VITE_ variable.
# VITE_PADDLE_CLIENT_TOKEN=test_your_paddle_client_token

# ── Hosted Cloud control plane ───────────────────────────────────────────────
# Keep false for every self-hosted installation. Enable only with the complete
# launch checklist in docs/CLOUD-LAUNCH.md and a tested staging lifecycle.
VITAE_CLOUD_ENABLED=false
# Fourfold productivity command API (`/api/v1/productivity`). Default off.
# Truthy values: true / 1 / yes. Unset or any other value keeps the mount as 404.
VITAE_PRODUCTIVITY_ENABLED=false
# Fourfold productivity web surfaces (`/today/tasks` and siblings). Default off.
# Truthy values: true / 1 / yes. Unset or any other value keeps nav and commands hidden.
# Bookmarks still resolve behind AuthGate to a short "not available" page.
VITE_PUBLIC_PRODUCTIVITY_ENABLED=false
# Canonical browser origin used by provider return links and account messaging.
# PUBLIC_APP_URL=https://app.example.com
# Paddle server credentials and server-owned price IDs. Put these only in the
# deployment secret manager, never in a VITE_ variable or committed .env file.
PADDLE_ENVIRONMENT=sandbox
# PADDLE_API_KEY=pdl_sdbx_apikey_your_server_secret
# PADDLE_WEBHOOK_SECRET=pdl_ntfset_your_webhook_secret
# PADDLE_PRICE_CLOUD_MONTHLY=pri_your_monthly_price
# PADDLE_PRICE_CLOUD_ANNUAL=pri_your_annual_price

# ── Auth (SRS INT-1 / FR-SET-001) ────────────────────────────────────────────
# The single allow-listed owner identity. Non-matching sign-ins are refused.
# This address is the sole identity admitted by this installation.
OWNER_EMAIL=owner@example.com

# Where the compiled documentation corpus lives on disk.
#
# The corpus is served by this API rather than by the public web host, because
# it is private: the curated half describes every trust boundary and known gap
# in the system, and the generated half enumerates every route, endpoint, table
# and exported symbol in the repository. Behind the API it inherits the
# OWNER_EMAIL allow-list above, which is the only reason it is readable at all.
#
# Build it with `pnpm docs:build` (writes docs/.compiled) and point this at the
# result. Unset means this deployment carries no documentation, and /api/v1/docs
# says so rather than reporting an empty corpus.
DOCS_CONTENT_DIR=docs/.compiled
# Enables the "Developer sign-in" shortcut on /signin (dev only).
AUTH_ENABLE_DEV_LOGIN=true
# 32+ byte random string used to sign dev-login session tokens.
SESSION_SECRET=change-me-to-a-long-random-string

# ── Companion app (Aperture) ─────────────────────────────────────────────────
# Aperture signs the same human in against its own Firebase project, and an ID
# token is scoped to the project that issued it. Naming that project here lets
# its tokens through. The OWNER_EMAIL check still gates every request, and a
# cross-project token additionally has to be a verified Google sign-in.
# Leave unset to keep this project the only accepted issuer.
# TRUSTED_FIREBASE_PROJECT_ID=companion-production
# Browser origin allowed to call this API alongside WEB_ORIGIN.
# APERTURE_ORIGIN=https://aperture.example.com

# ── Postgres: the data plane (ADR 0005) ──────────────────────────────────────
# Local default matches `docker compose up -d postgres`. 5433, not 5432, so it
# does not collide with another Postgres already on the machine.
DATABASE_URL=postgresql://vitae:vitae@127.0.0.1:5433/vitae
# Required whenever DATABASE_URL is not localhost: RDS certificates are signed
# by an Amazon CA that Node does not trust by default, and the alternative to
# supplying the bundle is accepting any certificate at all.
# DATABASE_CA_CERT=

# ── Firebase: AUTH ONLY (ADR 0005) ───────────────────────────────────────────
# Sign-in stayed on Firebase when the data plane moved: verifyIdToken is free,
# unmetered, and was never the constraint. There is no Firestore here.
GCLOUD_PROJECT=vitae-local
FIREBASE_PROJECT_ID=vitae-local
# When set, the Admin SDK talks to the local Auth emulator instead of prod.
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Web SDK config (emulator-safe placeholders are fine for local dev).
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=vitae-local.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=vitae-local
VITE_FIREBASE_USE_EMULATOR=true
# Where the Web SDK reaches the Auth emulator when USE_EMULATOR is true. The
# emulator serves its own Google account chooser, so "Continue with Google"
# works locally. Sign in as OWNER_EMAIL or the API's owner check rejects you.
VITE_FIREBASE_AUTH_EMULATOR_HOST=http://127.0.0.1:9099

# ── Storage: Cloudinary (SRS T5; owner-provided) ─────────────────────────────
# Single-URL form: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=cloudinary://your_key:your_secret@your_cloud
# Folder prefix for all Vitae uploads.
CLOUDINARY_FOLDER=vitae

# ── LaTeX build service (SRS §8.4) ───────────────────────────────────────────
BUILDSVC_URL=http://localhost:8787
# Shared secret for HMAC-SHA256 request signing (SRS T4). Must match buildsvc.
# This secret IS the compiler's authentication. buildsvc refuses to start
# without it and rejects the published development defaults in production.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BUILDSVC_HMAC_SECRET=change-me-to-a-shared-secret

# ── Third-party credentials (never stored as application data; FR-004) ───────
# GitHub PAT for repository sync. In production, inject this from the platform's
# secret manager (Cloud Run → Secret Manager, Fly secrets, ...). Leave it unset
# locally and use Settings → Connect GitHub, which writes it to the git-ignored
# file-backed secret store instead of the database.
# GITHUB_PAT=
# Where the file-backed secret store lives (default: <repo root>/.secrets).
# VITAE_SECRETS_DIR=

# ── Off-box backups (scripts/backup-to-s3.sh; see docs/runbooks/restore-drill.md)
# S3 URI prefix for automated full exports (includeSensitive). IAM least privilege
# on .../exports/* only. Prefer GHA OIDC or an EC2 instance role; no keys in git.
# BACKUP_S3_URI=s3://vitae-backups/prod
# BACKUP_DAY=2026-07-16
# DRY_RUN=1
# CONFIRM=YES
# Uploads are server-side encrypted (SSE-S3/AES256) by default; set a KMS CMK to
# use SSE-KMS instead. IAM must allow kms:GenerateDataKey/Decrypt on the key.
# BACKUP_SSE_KMS_KEY_ID=
