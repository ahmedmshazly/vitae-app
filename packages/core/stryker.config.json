{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "mutate": [
    "src/algorithms/latex-escape.ts",
    "src/algorithms/capture-grammar.ts",
    "src/algorithms/filter-grammar.ts",
    "src/forms/subjects.ts",
    "src/schema/validate.ts"
  ],
  "ignorePatterns": ["dist", "coverage", "reports", ".stryker-tmp"],
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": "always",
  "reporters": ["clear-text", "progress-append-only", "html"],
  "htmlReporter": {
    "fileName": "reports/mutation/mutation.html"
  },
  "thresholds": {
    "high": 80,
    "low": 70,
    "break": 60
  },
  "concurrency": 2,
  "timeoutMS": 60000,
  "disableTypeChecks": true
}
