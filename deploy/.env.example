# Copy to deploy/.env on the VM and fill in. Never commit deploy/.env.
# Full variable reference: docs/DEPLOYMENT.md §2.

# Public hostname of the API (DNS A record → this VM). Caddy gets its TLS cert for it.
API_DOMAIN=api.vitae.example.com

# Exact origin of the deployed web SPA (CORS).
WEB_ORIGIN=https://vitae.example.com,https://vitae-eta.vercel.app

# The single admitted Google account.
OWNER_EMAIL=you@gmail.com

# Never enable outside local dev.
AUTH_ENABLE_DEV_LOGIN=false

# Fresh 32+ byte random string:  openssl rand -hex 32
SESSION_SECRET=

# Postgres (ADR 0005). The RDS endpoint. The API refuses to boot in production
# with a localhost URL, because that would come up healthy against an empty
# database and start accepting writes into it.
DATABASE_URL=
# CA bundle for verifying the RDS certificate. Required: without it the API
# refuses to connect rather than silently accepting any certificate. Either the
# PEM itself or a path to it. An env file cannot hold a multi-line value, so on
# a host this is a path, mounted into the container by compose.prod.yml.
#   curl -o /home/ubuntu/vitae/deploy/rds-ca.pem \
#     https://truststore.pki.rds.amazonaws.com/eu-central-1/eu-central-1-bundle.pem
DATABASE_CA_CERT=/app/deploy/rds-ca.pem

# Firebase: AUTH ONLY. GOOGLE_APPLICATION_CREDENTIALS is the FULL service
# account JSON pasted as one line (apps/api/src/firebase.ts JSON.parses it).
FIREBASE_PROJECT_ID=vitae-production
GOOGLE_APPLICATION_CREDENTIALS=

# Cloudinary (file storage).
CLOUDINARY_URL=
CLOUDINARY_FOLDER=vitae

# Shared secret between API and the LaTeX build service:  openssl rand -hex 32
BUILDSVC_HMAC_SECRET=

# Off-box full-export backups (scripts/backup-to-s3.sh). Prefer IAM instance role
# or GitHub OIDC; do not commit AWS keys. See docs/runbooks/restore-drill.md.
# BACKUP_S3_URI=s3://vitae-backups/prod
