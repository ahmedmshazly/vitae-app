# Host-only env for the backup timer (not loaded by Docker Compose).
# Copy to /etc/vitae/backup.env on the API VM and chmod 0640.
#
# Auth: prefer an EC2 instance IAM role for S3. Firebase Admin comes from
# deploy/.env (GOOGLE_APPLICATION_CREDENTIALS). Do NOT put long-lived AWS
# keys here unless you have no instance profile.

BACKUP_S3_URI=s3://vitae-backups/prod
