# Copy to deploy/.env.personal and fill in. Never commit deploy/.env.personal.
# Procedure: docs/runbooks/personal-local.md

# The one identity this install admits. Owner sign-in issues a session for this address.
OWNER_EMAIL=you@example.com

# Fresh 32+ byte random strings:
#   openssl rand -hex 32
SESSION_SECRET=
BUILDSVC_HMAC_SECRET=
POSTGRES_PASSWORD=

# Firebase Admin still requires a project id. This install does not call Google.
# Use a placeholder so the schema parses; the web build keeps demo VITE_FIREBASE_*
# so Google sign-in stays unavailable.
FIREBASE_PROJECT_ID=vitae-personal

# Optional. Leave unset to serve no documentation corpus (API answers 503 on /docs).
# DOCS_CONTENT_DIR is set inside the container by compose.personal.yml.

# Optional Gemini connection (Data → Gemini). The key stays in this env file,
# never in Postgres. GEMENI_API_KEY and GEMENI_PROJECT are accepted aliases.
# GEMINI_API_KEY=
# GEMINI_PROJECT=
